RewriteEngine On
RewriteBase /

# 0. Skip rewrite for backend or public folders (allow direct access)
RewriteRule ^(easil_backend|public)/ - [L]

# 1. (Optional) Force HTTPS and www for production
# Commented for local development
# RewriteCond %{HTTPS} !=on [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Remove .php from URLs (only for public frontend routes)
RewriteCond %{THE_REQUEST} \s/(.+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L,NC]

# 3. Internally add .php if file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# 4. API Routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ easil_backend/routes/api.php [QSA,L]

# 5. Main routing to frontend index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ easil/index.php [QSA,L]

# 6. Custom 404 Page
ErrorDocument 404 /public/errors/404.php

# 7. Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
</IfModule>
